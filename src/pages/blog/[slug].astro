---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../consts';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `${SITE.url}/blog/${post.id}`;
---

<BaseLayout
  title={`${post.data.title} | velix`}
  description={post.data.description}
  image={post.data.coverImage}
  type="article"
>
  <Header />

  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    image: `${SITE.url}${post.data.coverImage}`,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: post.data.pubDate.toISOString(),
    url,
    author: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  })} />

  <article class="relative overflow-hidden pt-32 pb-20 sm:pt-40">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="pointer-events-none absolute top-0 left-1/2 h-[420px] w-[720px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/8 blur-[120px]"></div>
    </div>

    <div class="relative mx-auto max-w-3xl px-6">
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 font-mono text-[0.7rem] tracking-widest text-text-muted uppercase transition-colors hover:text-primary"
      >
        <span class="transition-transform duration-300 group-hover:-translate-x-0.5">←</span>
        Volver al blog
      </a>

      <div class="mt-8 mb-6 flex flex-wrap items-center gap-2.5">
        <span class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 font-mono text-[0.62rem] tracking-wide text-primary uppercase">
          {post.data.category}
        </span>
        <span class="font-mono text-[0.65rem] text-text-muted">{post.data.readTime}</span>
        <span class="h-0.5 w-0.5 rounded-full bg-text-muted"></span>
        <span class="font-mono text-[0.65rem] text-text-muted">
          {post.data.pubDate.toLocaleDateString('es', { day: '2-digit', month: 'long', year: 'numeric' })}
        </span>
      </div>

      <h1 class="text-3xl leading-[1.1] font-semibold tracking-tight sm:text-[2.9rem]">
        {post.data.title}
      </h1>

      <p class="mt-5 text-base leading-relaxed text-text-secondary sm:text-lg">
        {post.data.description}
      </p>

      <img
        src={post.data.coverImage}
        alt={post.data.coverAlt}
        class="mt-10 mb-12 aspect-[21/9] w-full rounded-2xl border border-white/8 object-cover"
      />

      <div class="prose max-w-none">
        <Content />
      </div>

      <div class="relative mt-16 overflow-hidden rounded-2xl border border-white/10 bg-surface-light p-8 text-center sm:p-10">
        <div class="pointer-events-none absolute -top-20 left-1/2 h-40 w-64 -translate-x-1/2 rounded-full bg-primary/15 blur-3xl" aria-hidden="true"></div>
        <div class="relative">
          <h3 class="font-display text-2xl font-semibold text-text-primary">¿Te ha resultado útil?</h3>
          <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-text-secondary">
            Si necesitas aplicar estas ideas en tu proyecto, podemos diseñarlo y construirlo contigo.
          </p>
          <a
            href="/#contacto"
            class="btn-shimmer mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-surface transition-all hover:bg-primary-light"
          >
            <span class="relative z-10">Cotizar proyecto</span>
            <span class="relative z-10">→</span>
          </a>
        </div>
      </div>
    </div>
  </article>
  <Footer />
</BaseLayout>
