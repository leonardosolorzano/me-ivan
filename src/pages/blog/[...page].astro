---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogList from '../../components/BlogList.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { POSTS_PER_PAGE } from '../../consts';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return paginate(allPosts, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
  title={`Blog - Página ${page.currentPage} | velix`}
  description="Estrategias, consejos y buenas prácticas para llevar tu negocio al siguiente nivel con presencia digital profesional."
>
  <Header />
  <main class="relative overflow-hidden pt-32 pb-20 sm:pt-40">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="bg-grid absolute inset-0"></div>
      <div class="aurora-blob left-[-10%] top-[-20%] h-[380px] w-[380px] bg-primary/10"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-6">
      <div class="mb-14 max-w-2xl" data-reveal>
        <p class="eyebrow">
          <span class="h-px w-8 bg-primary/60"></span>
          Blog
        </p>
        <h1 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl">
          Aprende a construir
          <span class="text-gradient"> mejor.</span>
        </h1>
        <p class="mt-5 text-base leading-relaxed text-text-secondary sm:text-lg">
          Estrategias, rendimiento y buenas prácticas para que tu presencia
          digital trabaje a favor de tu negocio.
        </p>
      </div>

      <BlogList page={page} />
    </div>
  </main>
  <Footer />
</BaseLayout>
