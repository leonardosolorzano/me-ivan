---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 - Página no encontrada | velix" description="La página que buscas no existe.">
  <Header />
  <main class="flex min-h-screen items-center justify-center pt-20">
    <div class="mx-auto max-w-xl px-6 py-24 text-center">
      <p class="mb-4 text-8xl font-black tracking-tight text-white/10">404</p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight">Página no encontrada</h1>
      <p class="mb-10 text-text-secondary">
        La página que buscas no existe o fue movida. Vuelve al inicio para seguir explorando.
      </p>
      <a
        href="/"
        class="inline-block rounded-full bg-primary px-8 py-3.5 text-sm font-semibold text-surface transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/25"
      >
        Volver al inicio
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
