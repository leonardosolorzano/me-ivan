---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — Página no encontrada | velix" description="La página que buscas no existe.">
  <Header />
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden pt-20">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="bg-grid absolute inset-0"></div>
      <div class="aurora-blob left-1/2 top-1/3 h-[380px] w-[380px] -translate-x-1/2 bg-primary/12"></div>
    </div>

    <div class="relative mx-auto max-w-xl px-6 py-24 text-center">
      <p class="font-display text-[7rem] leading-none font-bold tracking-tighter text-transparent sm:text-[10rem]" style="-webkit-text-stroke: 1px rgba(240,184,119,0.35);">
        404
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Página no encontrada</h1>
      <p class="mx-auto mt-4 max-w-sm text-sm leading-relaxed text-text-secondary sm:text-base">
        La página que buscas no existe o fue movida. Vuelve al inicio para seguir explorando.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href="/"
          class="btn-shimmer inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-surface transition-all hover:bg-primary-light hover:shadow-glow"
        >
          <span class="relative z-10">Volver al inicio</span>
          <span class="relative z-10">→</span>
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-full border border-white/12 px-7 py-3.5 text-sm font-semibold text-text-primary transition-all hover:border-white/25 hover:bg-white/5"
        >
          Ir al blog
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
