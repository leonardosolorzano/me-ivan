---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

type BlogEntry = CollectionEntry<'blog'>;

interface Props {
  page: Page<BlogEntry>;
}

const { page } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2">
  {page.data.map((post, index) => (
    <a
      href={`/blog/${post.id}`}
      data-reveal
      style={`--reveal-delay: ${(index % 2) * 90}ms`}
      class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-surface-light transition-all duration-300 hover:-translate-y-1 hover:border-white/16 hover:shadow-[0_30px_60px_-30px_rgba(0,0,0,0.9)]"
    >
      <div class="relative overflow-hidden">
        <img
          src={post.data.coverImage}
          alt={post.data.coverAlt}
          class="aspect-[21/9] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-surface-light via-transparent to-transparent opacity-70"></div>
        <span class="absolute top-4 left-4 rounded-full border border-white/15 bg-surface/70 px-3 py-1 font-mono text-[0.62rem] tracking-wide text-text-primary uppercase backdrop-blur-md">
          {post.data.category}
        </span>
      </div>

      <div class="flex flex-1 flex-col p-7">
        <div class="mb-3 flex items-center gap-2.5 font-mono text-[0.65rem] text-text-muted">
          <span>{post.data.pubDate.toLocaleDateString('es', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
          <span class="h-0.5 w-0.5 rounded-full bg-text-muted"></span>
          <span>{post.data.readTime}</span>
        </div>

        <h2 class="text-xl leading-snug font-semibold text-text-primary transition-colors duration-300 group-hover:text-primary-light">
          {post.data.title}
        </h2>
        <p class="mt-2.5 text-sm leading-relaxed text-text-secondary">
          {post.data.description}
        </p>

        <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-primary">
          Leer artículo
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </span>
      </div>
    </a>
  ))}
</div>

<nav class="mt-12 flex items-center justify-center gap-4" aria-label="Paginación del blog">
  <a
    href={page.url.prev ?? '#'}
    class={`inline-flex items-center gap-1.5 rounded-full border px-5 py-2.5 text-sm font-medium transition-all ${
      page.url.prev
        ? 'border-white/10 text-text-primary hover:border-white/25 hover:bg-white/5'
        : 'pointer-events-none border-white/5 text-text-muted opacity-40'
    }`}
  >
    ← Anterior
  </a>
  <span class="font-mono text-xs text-text-muted">
    {page.currentPage} / {page.lastPage}
  </span>
  <a
    href={page.url.next ?? '#'}
    class={`inline-flex items-center gap-1.5 rounded-full border px-5 py-2.5 text-sm font-medium transition-all ${
      page.url.next
        ? 'border-white/10 text-text-primary hover:border-white/25 hover:bg-white/5'
        : 'pointer-events-none border-white/5 text-text-muted opacity-40'
    }`}
  >
    Siguiente →
  </a>
</nav>
