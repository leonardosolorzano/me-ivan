---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section id="blog" class="relative border-t border-white/5 py-28 sm:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-14 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">
          <span class="h-px w-8 bg-accent/60"></span>
          Blog
        </p>
        <h2 class="mt-5 text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">
          Ideas para construir
          <span class="text-gradient"> mejor.</span>
        </h2>
        <p class="mt-5 text-base leading-relaxed text-text-secondary">
          Estrategias, rendimiento y buenas prácticas para que tu presencia
          digital trabaje a favor de tu negocio.
        </p>
      </div>

      <a
        href="/blog"
        data-reveal="right"
        class="group inline-flex shrink-0 items-center gap-2 rounded-full border border-white/10 px-5 py-2.5 text-sm font-medium text-text-secondary transition-all hover:border-white/25 hover:text-text-primary"
      >
        Ver todos los artículos
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {posts.map((post, index) => (
        <a
          href={`/blog/${post.id}`}
          data-reveal
          style={`--reveal-delay: ${index * 90}ms`}
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-white/8 bg-surface-light transition-all duration-300 hover:-translate-y-1 hover:border-white/16 hover:shadow-[0_30px_60px_-30px_rgba(0,0,0,0.9)]"
        >
          <div class="relative overflow-hidden">
            <img
              src={post.data.coverImage}
              alt={post.data.coverAlt}
              class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-light via-surface-light/10 to-transparent opacity-80"></div>
            <span class="absolute top-4 left-4 rounded-full border border-white/15 bg-surface/70 px-3 py-1 font-mono text-[0.62rem] tracking-wide text-text-primary uppercase backdrop-blur-md">
              {post.data.category}
            </span>
          </div>

          <div class="flex flex-1 flex-col p-6">
            <div class="mb-3 flex items-center gap-2.5 font-mono text-[0.65rem] text-text-muted">
              <span>{post.data.pubDate.toLocaleDateString('es', { day: '2-digit', month: 'short', year: 'numeric' })}</span>
              <span class="h-0.5 w-0.5 rounded-full bg-text-muted"></span>
              <span>{post.data.readTime}</span>
            </div>

            <h3 class="text-lg leading-snug font-semibold text-text-primary transition-colors duration-300 group-hover:text-primary-light">
              {post.data.title}
            </h3>
            <p class="mt-2.5 line-clamp-2 text-sm leading-relaxed text-text-secondary">
              {post.data.description}
            </p>

            <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-primary">
              Leer artículo
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 text-center sm:hidden">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-full border border-white/10 px-5 py-2.5 text-sm font-medium text-text-secondary transition-all hover:border-white/25 hover:text-text-primary"
      >
        Ver todos los artículos →
      </a>
    </div>
  </div>
</section>
