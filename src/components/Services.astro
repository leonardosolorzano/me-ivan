---
const services = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    title: 'Frontend Development',
    description: 'Interfaces modernas, responsivas y accesibles con React, Vue, Svelte o frameworks como Astro. Experiencias de usuario que convierten.',
    tags: ['React', 'Vue', 'Astro', 'Tailwind CSS'],
    gradient: 'from-primary/20 to-accent/20',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Backend Development',
    description: 'APIs robustas y escalables con Node.js, Python, Go o Rust. Microservicios, autenticación, integraciones y lógica de negocio compleja.',
    tags: ['Node.js', 'Python', 'Go', 'REST/GraphQL'],
    gradient: 'from-primary-dark/20 to-primary/20',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
    title: 'Bases de Datos',
    description: 'Diseño, optimización y administración de bases de datos SQL y NoSQL. Migraciones, replicación, backups y monitoreo de alto rendimiento.',
    tags: ['PostgreSQL', 'MongoDB', 'Redis', 'MySQL'],
    gradient: 'from-accent/15 to-primary-light/15',
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
    title: 'DevOps & Cloud',
    description: 'Infraestructura como código, CI/CD, contenedores y despliegue en la nube. Automatización que acelera tu time-to-market.',
    tags: ['Docker', 'AWS', 'CI/CD', 'Kubernetes'],
    gradient: 'from-primary/15 to-primary-dark/20',
  },
];
---

<section id="servicios" class="relative py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 max-w-2xl">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-accent">
        Servicios
      </h2>
      <h3 class="mb-6 text-4xl font-bold tracking-tight">
        Soluciones completas para cada etapa
      </h3>
      <p class="text-text-secondary">
        Desde la concepción hasta el despliegue, cubrimos todo el stack tecnológico
        para que tu proyecto sea un éxito.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {services.map((service) => (
        <div class="group relative overflow-hidden rounded-2xl border border-white/5 bg-surface-light p-8 transition-all hover:border-white/10 hover:bg-surface-lighter">
          <div class={`absolute inset-0 bg-gradient-to-br ${service.gradient} opacity-0 transition-opacity group-hover:opacity-100`}></div>
          <div class="relative">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-white/5 text-accent transition-colors group-hover:bg-white/10">
              <Fragment set:html={service.icon} />
            </div>
            <h4 class="mb-3 text-xl font-bold">{service.title}</h4>
            <p class="mb-6 text-sm leading-relaxed text-text-secondary">
              {service.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {service.tags.map((tag) => (
                <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-text-muted">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
