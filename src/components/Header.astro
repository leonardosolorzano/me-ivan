---
const navItems = [
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Blog', href: '/blog' },
  { label: 'Nosotros', href: '/#nosotros' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <nav
    id="nav-bar"
    aria-label="Navegación principal"
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4 transition-all duration-500"
  >
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight transition-all duration-500 shrink-0" aria-label="velix - Inicio">
      <img
        id="logo-icon"
        src="/images/logo-velix.png"
        alt="velix"
        class="h-9 w-9 rounded-lg object-cover transition-all duration-500"
      />
      <span
        id="logo-text"
        class="text-xl transition-all duration-500"
      >
        velix
      </span>
    </a>

    <ul class="hidden items-center gap-1 transition-all duration-500 lg:flex" id="nav-links">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="rounded-full px-4 py-2 text-sm font-medium text-text-secondary transition-colors hover:bg-white/5 hover:text-text-primary"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="/#contacto"
        class="hidden rounded-full bg-primary px-5 py-2 text-sm font-semibold text-surface transition-all hover:bg-primary-light hover:shadow-lg hover:shadow-primary/25 shrink-0 sm:inline-block"
      >
        Cotizar proyecto
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-text-primary transition-colors hover:bg-white/10 lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"/>
          <line x1="4" y1="12" x2="20" y2="12"/>
          <line x1="4" y1="18" x2="20" y2="18"/>
        </svg>
        <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18"/>
          <line x1="18" y1="6" x2="6" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="hidden lg:hidden"
  >
    <div class="mx-auto max-w-7xl px-6 pb-6">
      <div class="rounded-2xl border border-white/10 bg-surface-light/95 p-4 shadow-2xl shadow-black/40 backdrop-blur-xl">
        <ul class="flex flex-col">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-xl px-4 py-3 text-base font-medium text-text-secondary transition-colors hover:bg-white/5 hover:text-text-primary"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/#contacto"
          class="mt-3 block rounded-full bg-primary px-5 py-3 text-center text-sm font-semibold text-surface transition-all hover:bg-primary-light"
        >
          Cotizar proyecto
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  #site-header.scrolled {
    background: rgba(10, 14, 26, 0.8);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  #site-header.scrolled #nav-bar {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  #site-header.scrolled #logo-icon {
    height: 2rem;
    width: 2rem;
  }

  #site-header.scrolled #logo-text {
    font-size: 1.125rem;
  }

  #site-header.scrolled #nav-links {
    gap: 0;
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const SCROLL_THRESHOLD = 80;

  function onScroll() {
    if (header) header.classList.toggle('scrolled', window.scrollY > SCROLL_THRESHOLD);
  }

  function setMenuOpen(open: boolean) {
    if (!mobileMenu || !menuToggle || !iconOpen || !iconClose) return;
    mobileMenu.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }

  if (menuToggle) {
    menuToggle.addEventListener('click', () => {
      const isOpen = mobileMenu ? !mobileMenu.classList.contains('hidden') : false;
      setMenuOpen(!isOpen);
    });
  }

  if (mobileMenu) {
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
