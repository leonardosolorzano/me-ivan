---
import TechMarquee from './TechMarquee.astro';

const groups = [
  {
    label: 'Frontend',
    hint: 'Interfaces rápidas y accesibles',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    items: ['Astro', 'Next.js', 'React', 'Tailwind CSS', 'JavaScript'],
  },
  {
    label: 'Backend',
    hint: 'APIs fiables y tipadas',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14"/></svg>`,
    items: ['Python', 'FastAPI', 'Node.js'],
  },
  {
    label: 'Datos & CMS',
    hint: 'Contenido y persistencia',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
    items: ['PostgreSQL', 'Strapi', 'Redis'],
  },
  {
    label: 'Infraestructura',
    hint: 'Deploy y automatización',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>`,
    items: ['Docker', 'GitHub Actions', 'Vercel', 'Cloudflare'],
  },
];
---

<section id="tecnologias" class="relative overflow-hidden border-y border-white/5 bg-surface-light/40 py-24 sm:py-28">
  <div class="bg-grid-fade pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div data-reveal="left">
        <p class="eyebrow">
          <span class="h-px w-8 bg-accent/60"></span>
          Tecnologías
        </p>
        <h2 class="mt-5 text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">
          Un stack moderno,
          <span class="text-gradient">sin ataduras.</span>
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-text-secondary">
          Elegimos la herramienta por el problema, no al revés. Trabajamos con
          tecnologías probadas que tu equipo podrá entender y mantener mañana.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/8 bg-white/[0.03] px-3.5 py-1.5 text-xs text-text-secondary">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            Código abierto primero
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/8 bg-white/[0.03] px-3.5 py-1.5 text-xs text-text-secondary">
            <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
            Sin dependencias innecesarias
          </span>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {groups.map((group, index) => (
          <div
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
            class="group rounded-2xl border border-white/8 bg-surface/60 p-5 backdrop-blur-sm transition-colors duration-300 hover:border-white/16 sm:p-6"
          >
            <div class="flex items-start gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-white/8 bg-white/[0.04] text-primary transition-transform duration-300 group-hover:scale-110">
                <Fragment set:html={group.icon} />
              </span>
              <div>
                <h3 class="text-sm font-semibold text-text-primary">{group.label}</h3>
                <p class="mt-0.5 text-xs text-text-muted">{group.hint}</p>
              </div>
            </div>

            <ul class="mt-5 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="rounded-lg border border-white/8 bg-white/[0.03] px-2.5 py-1 font-mono text-[0.68rem] text-text-secondary">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="relative mt-16 space-y-3">
    <TechMarquee />
    <TechMarquee reverse />
  </div>
</section>
