---
import { actions } from 'astro:actions';
import { SITE } from '../consts';

const nextSteps = [
  'Nos cuentas tu idea y objetivos',
  'Te respondemos en menos de 24 horas',
  'Recibes una propuesta clara y sin compromiso',
];
---

<section id="contacto" class="relative overflow-hidden border-t border-white/5 py-28 sm:py-32">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="bg-grid-fade absolute inset-0"></div>
    <div class="aurora-blob bottom-[-25%] left-[10%] h-[420px] w-[520px] bg-primary/10"></div>
    <div class="aurora-blob top-[10%] right-[-10%] h-[360px] w-[360px] bg-violet/10 [animation-delay:-9s]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div data-reveal="left">
        <p class="eyebrow">
          <span class="h-px w-8 bg-primary/60"></span>
          Contacto
        </p>
        <h2 class="mt-5 text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl">
          ¿Tienes un proyecto
          <span class="text-gradient"> en mente?</span>
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-text-secondary sm:text-lg">
          Cuéntanos qué necesitas y te daremos una propuesta clara:
          alcance, plazo y precio. La primera consulta es gratis.
        </p>

        <ol class="mt-9 space-y-4">
          {nextSteps.map((step, index) => (
            <li class="flex items-start gap-3.5 text-sm text-text-secondary">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-primary/20 bg-primary/10 font-mono text-[0.62rem] text-primary">
                {index + 1}
              </span>
              {step}
            </li>
          ))}
        </ol>

        <div class="mt-10 grid gap-3 sm:grid-cols-2">
          <a
            href={`mailto:${SITE.email}`}
            class="group rounded-2xl border border-white/8 bg-white/[0.02] p-5 transition-colors hover:border-white/16 hover:bg-white/[0.04]"
          >
            <p class="font-mono text-[0.62rem] tracking-widest text-text-muted uppercase">Email directo</p>
            <p class="mt-2 text-sm font-medium text-text-primary transition-colors group-hover:text-primary-light">
              {SITE.email}
            </p>
          </a>
          <div class="rounded-2xl border border-white/8 bg-white/[0.02] p-5">
            <p class="font-mono text-[0.62rem] tracking-widest text-text-muted uppercase">Disponibilidad</p>
            <p class="mt-2 inline-flex items-center gap-2 text-sm font-medium text-text-primary">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Aceptando proyectos
            </p>
          </div>
        </div>
      </div>

      <div data-reveal="right" class="relative">
        <div
          class="pointer-events-none absolute -inset-4 -z-10 rounded-[2.25rem] bg-gradient-to-br from-primary/15 via-transparent to-accent/10 blur-2xl"
          aria-hidden="true"
        ></div>

        <div class="relative rounded-[1.75rem] border border-white/10 bg-surface-light/80 p-6 shadow-[0_40px_100px_-40px_rgba(0,0,0,1)] backdrop-blur-xl sm:p-8">
          <div class="mb-7 flex items-center justify-between">
            <div>
              <h3 class="font-display text-xl font-semibold text-text-primary">Cuéntanos tu idea</h3>
              <p class="mt-1 text-xs text-text-muted">Campos obligatorios marcados con *</p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
            </span>
          </div>

          <div id="form-status" aria-live="polite"></div>

          <form id="contact-form" method="POST" action={actions.contact} class="space-y-5 text-left">
            <input type="hidden" name="website" value="" aria-hidden="true" tabindex="-1" autocomplete="off" />

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block font-mono text-[0.65rem] tracking-widest text-text-secondary uppercase">
                  Nombre *
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  placeholder="Tu nombre"
                  aria-required="true"
                  class="form-input w-full rounded-xl border border-white/10 bg-surface/70 px-4 py-3 text-sm text-text-primary transition-colors placeholder:text-text-muted hover:border-white/20 focus:border-primary focus:bg-surface focus:outline-none focus:ring-1 focus:ring-primary/50"
                />
                <p id="name-error" class="form-error mt-1.5 hidden text-xs text-red-300"></p>
              </div>
              <div>
                <label for="email" class="mb-2 block font-mono text-[0.65rem] tracking-widest text-text-secondary uppercase">
                  Email *
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="tu@email.com"
                  aria-required="true"
                  class="form-input w-full rounded-xl border border-white/10 bg-surface/70 px-4 py-3 text-sm text-text-primary transition-colors placeholder:text-text-muted hover:border-white/20 focus:border-primary focus:bg-surface focus:outline-none focus:ring-1 focus:ring-primary/50"
                />
                <p id="email-error" class="form-error mt-1.5 hidden text-xs text-red-300"></p>
              </div>
            </div>

            <div>
              <label for="service" class="mb-2 block font-mono text-[0.65rem] tracking-widest text-text-secondary uppercase">
                Servicio de interés *
              </label>
              <select
                id="service"
                name="service"
                required
                aria-required="true"
                class="form-input w-full appearance-none rounded-xl border border-white/10 bg-surface/70 px-4 py-3 text-sm text-text-primary transition-colors hover:border-white/20 focus:border-primary focus:bg-surface focus:outline-none focus:ring-1 focus:ring-primary/50"
              >
                <option value="">Selecciona un servicio</option>
                <option value="web-estatica">Web estática</option>
                <option value="web-dinamica">Web dinámica</option>
                <option value="api-backend">API / Backend con FastAPI</option>
                <option value="cms">CMS con Strapi</option>
                <option value="rendimiento-seo">Rendimiento & SEO</option>
                <option value="fullstack">Proyecto full stack</option>
              </select>
              <p id="service-error" class="form-error mt-1.5 hidden text-xs text-red-300"></p>
            </div>

            <div>
              <label for="message" class="mb-2 block font-mono text-[0.65rem] tracking-widest text-text-secondary uppercase">
                Cuéntanos sobre tu proyecto *
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                minlength="10"
                maxlength="2000"
                placeholder="Describe tu proyecto, objetivos y cualquier detalle relevante…"
                aria-required="true"
                class="form-input w-full resize-none rounded-xl border border-white/10 bg-surface/70 px-4 py-3 text-sm text-text-primary transition-colors placeholder:text-text-muted hover:border-white/20 focus:border-primary focus:bg-surface focus:outline-none focus:ring-1 focus:ring-primary/50"
              ></textarea>
              <p id="message-error" class="form-error mt-1.5 hidden text-xs text-red-300"></p>
            </div>

            <button
              id="submit-btn"
              type="submit"
              class="btn-shimmer w-full rounded-full bg-primary px-8 py-4 text-sm font-semibold text-surface transition-all hover:bg-primary-light hover:shadow-[0_16px_50px_-14px_rgba(240,184,119,0.85)] disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span class="relative z-10">Enviar mensaje</span>
            </button>

            <p class="text-center text-[0.68rem] leading-relaxed text-text-muted">
              Al enviar aceptas que te contactemos sobre tu proyecto. Sin spam.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { actions } from 'astro:actions';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitLabel = submitBtn?.querySelector('span');
  const defaultLabel = submitLabel?.textContent ?? 'Enviar mensaje';

  const fieldErrorMap = {
    name: 'name-error',
    email: 'email-error',
    service: 'service-error',
    message: 'message-error',
  } as const;

  type FieldKey = keyof typeof fieldErrorMap;

  function showFieldErrors(fields: object) {
    for (const [field, messages] of Object.entries(fields)) {
      if (!(field in fieldErrorMap)) continue;
      const errorEl = document.getElementById(fieldErrorMap[field as FieldKey]);
      const input = form?.querySelector(`[name="${field}"]`);
      if (errorEl && input) {
        errorEl.textContent = (messages as string[]).join(', ');
        errorEl.classList.remove('hidden');
        input.classList.add('border-red-400/50', 'focus:border-red-400', 'focus:ring-red-400');
        input.setAttribute('aria-invalid', 'true');
      }
    }
  }

  function clearFieldErrors() {
    document.querySelectorAll('.form-error').forEach((el) => {
      el.textContent = '';
      el.classList.add('hidden');
    });
    document.querySelectorAll('.form-input').forEach((input) => {
      input.classList.remove('border-red-400/50', 'focus:border-red-400', 'focus:ring-red-400');
      input.removeAttribute('aria-invalid');
    });
  }

  function showStatus(message: string, type: 'error' | 'success') {
    const base = 'mb-5 rounded-xl px-4 py-3 text-sm';
    const styles =
      type === 'error'
        ? 'border border-red-400/20 bg-red-400/10 text-red-200'
        : 'border border-emerald-400/20 bg-emerald-400/10 text-emerald-200';
    if (status) status.innerHTML = `<p class="${base} ${styles}">${message}</p>`;
  }

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearFieldErrors();
      if (status) status.innerHTML = '';
      if (submitBtn) submitBtn.disabled = true;
      if (submitLabel) submitLabel.textContent = 'Enviando…';

      const formData = new FormData(form);
      const result = await actions.contact(formData);

      if (result.data) {
        form.reset();
        showStatus('¡Mensaje enviado! Te responderemos en menos de 24 horas.', 'success');
      } else {
        const error = result.error;
        if (error && 'fields' in error && error.fields) {
          showFieldErrors(error.fields);
          showStatus('Corrige los campos marcados en rojo e inténtalo de nuevo.', 'error');
        } else {
          showStatus(error?.message || 'No pudimos enviar tu mensaje. Inténtalo de nuevo.', 'error');
        }
      }

      if (submitBtn) submitBtn.disabled = false;
      if (submitLabel) submitLabel.textContent = defaultLabel;
    });
  }
</script>
