---
const pillars = [
  {
    title: 'Código propio y documentado',
    description: 'Sin plantillas ni cajas negras. Todo se entiende y se puede mantener.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    title: 'Diseño a medida',
    description: 'Cada interfaz nace de tu marca y de tus usuarios, no de un tema genérico.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>`,
  },
  {
    title: 'Comunicación directa',
    description: 'Hablas con quien escribe el código. Sin intermediarios ni tickets eternos.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    title: 'Entrega a tiempo',
    description: 'Plazos realistas, demos semanales y cero sorpresas al final del proyecto.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>`,
  },
];

const stats = [
  { value: 50, suffix: '+', label: 'Proyectos entregados' },
  { value: 5, suffix: '+', label: 'Años de experiencia' },
  { value: 99, suffix: '%', label: 'Clientes satisfechos' },
  { value: 100, suffix: '%', label: 'Código propio' },
];
---

<section id="nosotros" class="relative overflow-hidden border-t border-white/5 py-28 sm:py-32">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="aurora-blob right-[-10%] top-1/4 h-[360px] w-[360px] bg-primary/8"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="grid gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div data-reveal="left">
        <p class="eyebrow">
          <span class="h-px w-8 bg-primary/60"></span>
          Nosotros
        </p>
        <h2 class="mt-5 text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">
          Un equipo pequeño,
          <span class="text-gradient"> obsesionado con el detalle.</span>
        </h2>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-text-secondary sm:text-lg">
          No somos una fábrica de webs. Somos el socio técnico que se sienta contigo
          a pensar la solución, la construye y la deja lista para crecer.
        </p>

        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {pillars.map((pillar) => (
            <div class="group flex gap-3.5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-primary/15 bg-primary/8 text-primary transition-transform duration-300 group-hover:scale-110">
                <Fragment set:html={pillar.icon} />
              </span>
              <div>
                <h3 class="text-sm font-semibold text-text-primary">{pillar.title}</h3>
                <p class="mt-1 text-xs leading-relaxed text-text-secondary">{pillar.description}</p>
              </div>
            </div>
          ))}
        </div>

        <a
          href="#contacto"
          class="link-underline mt-10 inline-flex items-center gap-2 text-sm font-semibold text-text-primary"
        >
          Hablemos de tu proyecto
          <span class="text-primary">→</span>
        </a>
      </div>

      <div data-reveal="right" class="relative">
        <div
          class="animate-spin-slow pointer-events-none absolute -inset-6 rounded-[2.5rem] opacity-60"
          style="background: conic-gradient(from 0deg, transparent 0deg, rgba(240,184,119,0.18) 60deg, transparent 140deg, rgba(143,227,207,0.15) 220deg, transparent 320deg); filter: blur(28px);"
          aria-hidden="true"
        ></div>

        <div class="relative overflow-hidden rounded-[1.75rem] border border-white/10 bg-surface-light/80 p-7 backdrop-blur-xl sm:p-9">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/8 bg-white/[0.03] px-3 py-1 font-mono text-[0.62rem] tracking-widest text-text-muted uppercase">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Estudio independiente
            </span>
            <span class="font-mono text-[0.62rem] text-text-muted">ES / REMOTE</span>
          </div>

          <blockquote class="mt-8 font-display text-2xl leading-snug font-medium text-text-primary sm:text-[1.7rem]">
            “Código limpio, diseño intencional
            <span class="text-gradient"> y resultados medibles.</span>”
          </blockquote>

          <p class="mt-4 text-sm leading-relaxed text-text-secondary">
            Esa es la regla con la que empezamos cada proyecto. Sin humo,
            sin métricas inventadas.
          </p>

          <dl class="mt-9 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/8 bg-white/8">
            {stats.map((stat) => (
              <div class="bg-surface-light p-5">
                <dt class="sr-only">{stat.label}</dt>
                <dd
                  class="font-display text-3xl font-semibold text-text-primary"
                  data-count={stat.value}
                  data-suffix={stat.suffix}
                >
                  0{stat.suffix}
                </dd>
                <dd class="mt-1 text-[0.7rem] leading-snug text-text-muted">{stat.label}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-7 flex items-center justify-between border-t border-white/8 pt-6">
            <div class="flex -space-x-2">
              {['A', 'S', 'P'].map((letter, index) => (
                <span
                  class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-surface-light bg-gradient-to-br from-primary/25 to-accent/20 font-mono text-[0.65rem] font-semibold text-text-primary"
                  style={`opacity: ${1 - index * 0.12}`}
                >
                  {letter}
                </span>
              ))}
            </div>
            <p class="text-right text-[0.7rem] leading-snug text-text-muted">
              Diseño + desarrollo<br />
              <span class="text-text-secondary">en el mismo equipo</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
