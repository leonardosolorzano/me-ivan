---
import TechMarquee from './TechMarquee.astro';

const stats = [
  { value: 50, suffix: '+', label: 'Proyectos entregados' },
  { value: 99, suffix: '/100', label: 'Puntuación Lighthouse' },
  { value: 24, suffix: 'h', label: 'Tiempo de respuesta' },
];

const appNav = [
  {
    label: 'Resumen',
    active: true,
    icon: `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>`,
  },
  {
    label: 'Analítica',
    icon: `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/></svg>`,
  },
  {
    label: 'Clientes',
    icon: `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    label: 'Pedidos',
    icon: `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
  },
  {
    label: 'Ajustes',
    icon: `<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.14.6.68 1.03 1.31 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>`,
  },
];

const appMetrics = [
  { label: 'Ingresos', value: '$48.2k', change: '+12.4%', color: 'text-accent' },
  { label: 'Usuarios', value: '2.840', change: '+8.1%', color: 'text-primary' },
  { label: 'Conversiones', value: '6.7%', change: '+2.3%', color: 'text-violet' },
];

const appActivity = [
  { label: 'Nuevo pedido #1042', time: '2 min', amount: '+$249', dot: 'bg-accent' },
  { label: 'Usuario registrado', time: '18 min', amount: '+1', dot: 'bg-primary' },
  { label: 'Suscripción renovada', time: '1 h', amount: '+$89', dot: 'bg-violet' },
];
---

<section class="relative overflow-hidden pt-32 pb-12 sm:pt-40 lg:pt-44">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="bg-grid absolute inset-0"></div>
    <div class="aurora-blob left-[-10%] top-[-12%] h-[420px] w-[420px] bg-primary/20"></div>
    <div class="aurora-blob right-[-8%] top-[8%] h-[380px] w-[380px] bg-violet/20 [animation-delay:-6s]"></div>
    <div class="aurora-blob bottom-[-20%] left-[35%] h-[360px] w-[360px] bg-accent/10 [animation-delay:-12s]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      <!-- Copy -->
      <div>
        <div
          data-reveal
          class="mb-7 inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] py-1.5 pr-4 pl-2 text-xs text-text-secondary backdrop-blur-md"
        >
          <span class="relative flex h-2 w-2 items-center justify-center text-emerald-400">
            <span class="pulse-dot relative h-2 w-2 rounded-full bg-emerald-400"></span>
          </span>
          Disponibles para nuevos proyectos
          <span class="text-text-muted">·</span>
          <span class="font-mono text-[0.65rem] tracking-wider text-primary">2026</span>
        </div>

        <h1
          data-reveal
          style="--reveal-delay: 80ms"
          class="font-display text-[2.75rem] leading-[1.04] font-bold tracking-tight sm:text-6xl lg:text-[4.2rem]"
        >
          Webs que se sienten
          <span class="text-gradient text-gradient-animated block">del futuro.</span>
        </h1>

        <p
          data-reveal
          style="--reveal-delay: 160ms"
          class="mt-7 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg"
        >
          Creamos <strong class="font-medium text-text-primary">sitios estáticos ultrarrápidos</strong> y
          <strong class="font-medium text-text-primary">aplicaciones dinámicas</strong> conectadas a datos
          reales. Diseño a medida, código propio y un stack moderno de verdad.
        </p>

        <div data-reveal style="--reveal-delay: 240ms" class="mt-9 flex flex-wrap items-center gap-3">
          <a
            href="#contacto"
            class="btn-shimmer group inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-surface transition-all duration-300 hover:shadow-[0_16px_50px_-14px_rgba(240,184,119,0.85)]"
          >
            <span class="relative z-10">Empezar un proyecto</span>
            <svg
              class="relative z-10 h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a
            href="#servicios"
            class="group inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/[0.02] px-7 py-3.5 text-sm font-semibold text-text-primary backdrop-blur-sm transition-all duration-300 hover:border-white/25 hover:bg-white/[0.06]"
          >
            Ver servicios
            <span class="text-text-muted transition-transform duration-300 group-hover:translate-y-0.5">↓</span>
          </a>
        </div>

        <div
          data-reveal
          style="--reveal-delay: 320ms"
          class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-text-muted"
        >
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            Sin plantillas
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            Código 100% propio
          </span>
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            Entrega en semanas
          </span>
        </div>

        <dl
          data-reveal
          style="--reveal-delay: 400ms"
          class="mt-12 grid max-w-lg grid-cols-3 gap-4 border-t border-white/8 pt-8"
        >
          {stats.map((stat) => (
            <div>
              <dt class="sr-only">{stat.label}</dt>
              <dd
                class="font-display text-3xl font-semibold text-text-primary sm:text-[2rem]"
                data-count={stat.value}
                data-suffix={stat.suffix}
              >
                0{stat.suffix}
              </dd>
              <dd class="mt-1 text-[0.7rem] leading-snug text-text-muted">{stat.label}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Visual: maqueta de una app web real -->
      <div data-reveal="scale" style="--reveal-delay: 220ms" class="relative mx-auto w-full max-w-lg lg:max-w-none">
        <div
          class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-[radial-gradient(circle_at_30%_20%,rgba(240,184,119,0.25),transparent_60%),radial-gradient(circle_at_75%_75%,rgba(143,227,207,0.18),transparent_60%)] blur-2xl"
          aria-hidden="true"
        ></div>

        <div
          class="relative overflow-hidden rounded-3xl border border-white/10 bg-surface-light/80 shadow-[0_40px_100px_-40px_rgba(0,0,0,1)] backdrop-blur-xl"
        >
          <!-- Barra del navegador -->
          <div class="flex items-center gap-3 border-b border-white/8 bg-white/[0.02] px-4 py-3 sm:px-5">
            <div class="flex shrink-0 items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
            </div>
            <div class="flex min-w-0 flex-1 items-center justify-center gap-1.5 rounded-md border border-white/8 bg-black/25 px-2 py-1">
              <svg class="h-2.5 w-2.5 shrink-0 text-text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              <span class="truncate font-mono text-[0.62rem] text-text-muted sm:text-[0.7rem]">app.velix.dev/dashboard</span>
            </div>
            <span class="hidden shrink-0 font-mono text-[0.65rem] text-text-muted sm:block">↗</span>
          </div>

          <!-- Dashboard -->
          <div
            role="img"
            aria-label="Maqueta de un panel SaaS con métricas, gráfico de rendimiento y actividad reciente"
            class="flex min-h-[390px] sm:min-h-[420px]"
          >
            <!-- Sidebar -->
            <aside class="hidden w-[132px] shrink-0 flex-col border-r border-white/8 bg-black/20 px-3 py-4 sm:flex" aria-hidden="true">
              <div class="flex items-center gap-2 px-1">
                <img
                  src="/images/logo/logo-velix-mark.png"
                  alt=""
                  aria-hidden="true"
                  class="h-4 w-auto shrink-0"
                  width="640"
                  height="405"
                  loading="eager"
                  decoding="async"
                />
                <span class="font-display text-sm font-semibold text-text-primary">velix<span class="text-primary">.</span></span>
              </div>

              <p class="mt-6 px-1 font-mono text-[0.55rem] tracking-[0.18em] text-text-muted uppercase">Menú</p>
              <nav class="mt-2 space-y-0.5">
                {appNav.map((item) => (
                  <div
                    class:list={[
                      'flex items-center gap-2 rounded-lg px-2 py-2 text-[0.68rem] transition-colors',
                      item.active ? 'bg-primary/10 font-medium text-primary' : 'text-text-muted',
                    ]}
                  >
                    <Fragment set:html={item.icon} />
                    {item.label}
                  </div>
                ))}
              </nav>

              <div class="mt-auto flex items-center gap-2 rounded-lg border border-white/8 bg-white/[0.03] px-2 py-2">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-gradient-to-br from-violet/40 to-primary/30 font-mono text-[0.55rem] text-text-primary">IV</span>
                <div class="leading-tight">
                  <p class="text-[0.6rem] font-medium text-text-secondary">Iván</p>
                  <p class="font-mono text-[0.5rem] text-text-muted">Admin</p>
                </div>
              </div>
            </aside>

            <!-- Contenido principal -->
            <div class="min-w-0 flex-1 p-4 sm:p-5" aria-hidden="true">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="font-mono text-[0.55rem] tracking-[0.16em] text-text-muted uppercase">Panel / Resumen</p>
                  <h3 class="mt-0.5 font-display text-base font-semibold text-text-primary sm:text-lg">Buenos días, Iván 👋</h3>
                </div>
                <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-white/8 bg-white/[0.03] px-2.5 py-1 font-mono text-[0.55rem] text-text-muted">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
                  Últimos 30 días
                </span>
              </div>

              <!-- Métricas -->
              <div class="mt-4 grid grid-cols-3 gap-2 sm:gap-3">
                {appMetrics.map((metric) => (
                  <div class="rounded-xl border border-white/8 bg-white/[0.025] p-2.5 sm:p-3">
                    <p class="truncate text-[0.55rem] text-text-muted sm:text-[0.62rem]">{metric.label}</p>
                    <p class="mt-1 font-display text-sm font-semibold text-text-primary sm:text-base">{metric.value}</p>
                    <p class:list={['mt-0.5 font-mono text-[0.5rem] sm:text-[0.6rem]', metric.color]}>
                      {metric.change} <span class="text-text-muted">vs mes ant.</span>
                    </p>
                  </div>
                ))}
              </div>

              <!-- Gráfico -->
              <div class="mt-3 rounded-xl border border-white/8 bg-white/[0.025] p-3 sm:p-4">
                <div class="flex items-center justify-between gap-2">
                  <p class="text-[0.68rem] font-medium text-text-secondary sm:text-xs">Rendimiento</p>
                  <div class="flex items-center gap-2.5 font-mono text-[0.5rem] text-text-muted sm:text-[0.58rem]">
                    <span class="inline-flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>Ingresos</span>
                    <span class="hidden items-center gap-1 sm:inline-flex"><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Usuarios</span>
                  </div>
                </div>

                <svg class="mt-2 h-20 w-full sm:h-24" viewBox="0 0 320 100" preserveAspectRatio="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="heroChartFill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#8fe3cf" stop-opacity="0.32" />
                      <stop offset="100%" stop-color="#8fe3cf" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <g stroke="rgba(255,255,255,0.06)" stroke-width="1">
                    <line x1="0" y1="18" x2="320" y2="18" />
                    <line x1="0" y1="46" x2="320" y2="46" />
                    <line x1="0" y1="74" x2="320" y2="74" />
                  </g>
                  <path
                    d="M0 78 C24 72 40 82 62 62 S102 48 126 56 S166 30 190 40 S230 22 254 28 S294 12 320 16 L320 100 L0 100 Z"
                    fill="url(#heroChartFill)"
                  />
                  <path
                    d="M0 86 C28 82 44 70 66 76 S106 60 130 64 S170 48 194 54 S234 40 258 44 S296 32 320 34"
                    fill="none"
                    stroke="#f0b877"
                    stroke-width="2"
                    stroke-opacity="0.65"
                    stroke-linecap="round"
                  />
                  <path
                    d="M0 78 C24 72 40 82 62 62 S102 48 126 56 S166 30 190 40 S230 22 254 28 S294 12 320 16"
                    fill="none"
                    stroke="#8fe3cf"
                    stroke-width="2.5"
                    stroke-linecap="round"
                  />
                  <circle cx="254" cy="28" r="4" fill="#0b0d15" stroke="#8fe3cf" stroke-width="2" />
                </svg>
                <div class="mt-1 flex justify-between font-mono text-[0.5rem] text-text-muted">
                  <span>Jun</span><span>Jul</span><span>Ago</span><span>Sep</span>
                </div>
              </div>

              <!-- Actividad reciente -->
              <div class="mt-3 rounded-xl border border-white/8 bg-white/[0.025] px-3 py-1">
                {appActivity.map((row, index) => (
                  <div class:list={['flex items-center gap-2 py-2', index < appActivity.length - 1 ? 'border-b border-white/6' : '']}>
                    <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', row.dot]}></span>
                    <span class="min-w-0 flex-1 truncate text-[0.6rem] text-text-secondary sm:text-[0.66rem]">{row.label}</span>
                    <span class="shrink-0 font-mono text-[0.55rem] text-text-muted">{row.time}</span>
                    <span class="shrink-0 font-mono text-[0.55rem] text-accent">{row.amount}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Floating chips -->
        <div class="animate-float absolute -top-5 -left-4 hidden items-center gap-2 rounded-2xl border border-white/10 bg-surface-light/90 px-4 py-2.5 shadow-xl shadow-black/40 backdrop-blur-xl sm:flex">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-400/15 font-mono text-xs font-bold text-emerald-400">●</span>
          <div class="leading-tight">
            <p class="text-xs font-semibold text-text-primary">En producción</p>
            <p class="font-mono text-[0.6rem] text-text-muted">datos en vivo</p>
          </div>
        </div>

        <div class="animate-float-delayed absolute -right-4 top-1/3 hidden items-center gap-2 rounded-2xl border border-white/10 bg-surface-light/90 px-4 py-2.5 shadow-xl shadow-black/40 backdrop-blur-xl sm:flex">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary/15 font-mono text-xs font-bold text-primary">⚡</span>
          <div class="leading-tight">
            <p class="text-xs font-semibold text-text-primary">0.8 s</p>
            <p class="font-mono text-[0.6rem] text-text-muted">carga inicial</p>
          </div>
        </div>

        <div class="animate-float absolute -bottom-5 left-6 hidden items-center gap-2 rounded-2xl border border-white/10 bg-surface-light/90 px-4 py-2.5 shadow-xl shadow-black/40 backdrop-blur-xl sm:flex [animation-delay:-4s]">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-violet/15 font-mono text-xs font-bold text-violet">◈</span>
          <div class="leading-tight">
            <p class="text-xs font-semibold text-text-primary">100/100</p>
            <p class="font-mono text-[0.6rem] text-text-muted">Lighthouse</p>
          </div>
        </div>
      </div>
    </div>

    <div data-reveal style="--reveal-delay: 200ms" class="mt-20 sm:mt-24">
      <p class="mb-4 text-center font-mono text-[0.65rem] tracking-[0.28em] text-text-muted uppercase">
        Construido con herramientas que escalan
      </p>
      <TechMarquee />
    </div>
  </div>
</section>
