---
---

<section class="relative flex min-h-screen items-center overflow-hidden pt-20">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-1/2 top-0 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/15 blur-[128px]"></div>
    <div class="absolute bottom-0 right-0 h-[400px] w-[400px] translate-x-1/3 translate-y-1/3 rounded-full bg-accent/10 blur-[100px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 py-20">
    <div class="max-w-3xl">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-text-secondary">
        <span class="h-2 w-2 rounded-full bg-primary-light animate-pulse"></span>
        Disponibles para nuevos proyectos
      </div>

      <h1 class="mb-6 text-5xl font-black leading-[1.1] tracking-tight sm:text-6xl lg:text-7xl">
        Construimos el
        <span class="bg-gradient-to-r from-primary via-accent to-accent-light bg-clip-text text-transparent">
          futuro digital
        </span>
        que necesitas
      </h1>

      <p class="mb-10 max-w-xl text-lg leading-relaxed text-text-secondary">
        Somos una agencia especializada en desarrollo web, backend robusto,
        bases de datos optimizadas y frontend moderno. Convertimos tus ideas
        en productos escalables.
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="#contacto"
          class="rounded-full bg-primary px-8 py-3.5 text-sm font-semibold text-surface transition-all hover:bg-primary-light hover:shadow-xl hover:shadow-primary/25"
        >
          Empezar un proyecto
        </a>
        <a
          href="#servicios"
          class="rounded-full border border-white/10 px-8 py-3.5 text-sm font-semibold text-text-primary transition-all hover:border-white/25 hover:bg-white/5"
        >
          Ver servicios
        </a>
      </div>

      <div class="mt-16 grid grid-cols-3 gap-8 border-t border-white/10 pt-10">
        <div>
          <div class="text-3xl font-bold text-text-primary">50+</div>
          <div class="text-sm text-text-muted">Proyectos entregados</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-text-primary">5+</div>
          <div class="text-sm text-text-muted">Años de experiencia</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-text-primary">99%</div>
          <div class="text-sm text-text-muted">Clientes satisfechos</div>
        </div>
      </div>
    </div>
  </div>
</section>
