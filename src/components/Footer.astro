---
import { SITE } from '../consts';
import Logo from './Logo.astro';

const navigation = [
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Tecnologías', href: '/#tecnologias' },
  { label: 'Proceso', href: '/#proceso' },
  { label: 'Nosotros', href: '/#nosotros' },
  { label: 'Blog', href: '/blog' },
];

const services = [
  { label: 'Web estáticas', href: '/#servicios' },
  { label: 'Web dinámicas', href: '/#servicios' },
  { label: 'APIs con FastAPI', href: '/#servicios' },
  { label: 'CMS con Strapi', href: '/#servicios' },
  { label: 'Rendimiento & SEO', href: '/#servicios' },
];

const socials = [
  { label: 'X / Twitter', href: SITE.social.twitter, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L1.2 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L6.4 3.8H4.6L17.8 20Z"/></svg>` },
  { label: 'GitHub', href: SITE.social.github, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7 0-.7 0-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.1 4.6 18 5 18 5c.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg>` },
  { label: 'LinkedIn', href: SITE.social.linkedin, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0h3.8v1.7h.05c.53-1 1.83-2.05 3.76-2.05 4.02 0 4.76 2.65 4.76 6.1V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.07 1.4-2.07 2.85V21h-4V9Z"/></svg>` },
];
---

<footer class="relative overflow-hidden border-t border-white/5 pt-16">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute bottom-0 left-1/2 h-[280px] w-[600px] -translate-x-1/2 translate-y-1/2 rounded-full bg-primary/8 blur-[100px]"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="grid gap-12 pb-14 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr]">
      <div>
        <a href="/" aria-label="velix — Inicio">
          <Logo />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-text-secondary">
          Estudio de desarrollo web especializado en sitios estáticos ultrarrápidos
          y aplicaciones dinámicas a medida.
        </p>

        <div class="mt-6 flex gap-2">
          {socials.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/8 bg-white/[0.03] text-text-secondary transition-all hover:border-white/20 hover:bg-white/[0.06] hover:text-text-primary"
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="font-mono text-[0.62rem] tracking-[0.2em] text-text-muted uppercase">Navegación</h3>
        <ul class="mt-4 space-y-2.5">
          {navigation.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-text-secondary transition-colors hover:text-primary-light">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-[0.62rem] tracking-[0.2em] text-text-muted uppercase">Servicios</h3>
        <ul class="mt-4 space-y-2.5">
          {services.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-text-secondary transition-colors hover:text-primary-light">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-[0.62rem] tracking-[0.2em] text-text-muted uppercase">Empezar</h3>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          ¿Tienes una idea? Escríbenos y te respondemos en menos de 24 horas.
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="link-underline mt-4 inline-block text-sm font-medium text-text-primary"
        >
          {SITE.email}
        </a>
        <a
          href="/#contacto"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-xs font-semibold text-surface transition-all hover:bg-primary-light hover:shadow-glow"
        >
          Cotizar proyecto →
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/5 py-7 sm:flex-row">
      <p class="text-xs text-text-muted">
        © {new Date().getFullYear()} {SITE.name}. Todos los derechos reservados.
      </p>

      <div class="flex items-center gap-4">
        <p class="font-mono text-[0.62rem] text-text-muted">
          Astro · Tailwind · React · FastAPI
        </p>
        <a
          href="#top"
          class="group flex h-9 w-9 items-center justify-center rounded-xl border border-white/8 bg-white/[0.03] text-text-secondary transition-all hover:border-white/20 hover:text-text-primary"
          aria-label="Volver arriba"
        >
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none relative -mb-4 overflow-hidden text-center font-display text-[clamp(5rem,20vw,16rem)] leading-[0.8] font-bold tracking-tighter text-white/[0.025] select-none sm:-mb-8"
    aria-hidden="true"
  >
    velix
  </div>
</footer>
