---
import { SITE } from '../consts';
---

<footer class="border-t border-white/5 py-12">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <div class="flex items-center gap-2">
        <img src="/images/logo-velix.png" alt="velix" class="h-8 w-8 rounded-lg object-cover" />
        <span class="text-sm font-semibold">velix</span>
      </div>

      <p class="text-sm text-text-muted">
        &copy; {new Date().getFullYear()} velix. Todos los derechos reservados.
      </p>

      <div class="flex gap-6">
        <a href={SITE.social.twitter} class="text-sm text-text-muted transition-colors hover:text-text-primary">Twitter</a>
        <a href={SITE.social.github} class="text-sm text-text-muted transition-colors hover:text-text-primary">GitHub</a>
        <a href={SITE.social.linkedin} class="text-sm text-text-muted transition-colors hover:text-text-primary">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>
